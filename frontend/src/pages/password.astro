---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Zmiana hasła" narrow>
  <div class="page-head">
    <span class="eyebrow">Konto</span>
    <h1>Zmiana hasła</h1>
  </div>

  <p id="forced" class="alert info" hidden>Twoje hasło jest jednorazowe lub wygasło. Ustaw nowe, aby kontynuować.</p>

  <section class="card">
    <ul class="rules">
      <li>co najmniej <span id="min-length"></span> znaków</li>
      <li id="passphrase" hidden>fraza: co najmniej 3 słowa oddzielone spacją lub myślnikiem</li>
      <li>inne niż 3 ostatnio używane hasła</li>
    </ul>

    <form id="change" class="form">
      <label class="field">Obecne hasło
        <input name="current" type="password" autocomplete="current-password" required />
      </label>
      <label class="field">Nowe hasło
        <input name="new" type="password" autocomplete="new-password" required />
      </label>
      <label class="field">Powtórz nowe hasło
        <input name="repeat" type="password" autocomplete="new-password" required />
      </label>
      <p id="error" class="alert" role="alert"></p>
      <button class="btn block">Zmień hasło</button>
    </form>
  </section>
</Layout>

<script>
  import { api, currentUser, errorMessage, renderHeader, type PasswordPolicy } from "../lib/api";

  const errorBox = document.getElementById("error")!;

  const me = await currentUser();
  renderHeader(me);
  document.getElementById("forced")!.hidden = !me.must_change_password;

  const policy: PasswordPolicy = await (await api("/auth/password-policy")).json();
  document.getElementById("min-length")!.textContent = String(policy.min_length);
  document.getElementById("passphrase")!.hidden = !policy.passphrase_rule_enabled;

  document.getElementById("change")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(e.target as HTMLFormElement);
    if (data.get("new") !== data.get("repeat")) {
      errorBox.textContent = "Nowe hasła nie są takie same.";
      return;
    }
    const res = await api("/auth/password", {
      method: "POST",
      body: JSON.stringify({ current_password: data.get("current"), new_password: data.get("new") }),
    });
    if (res.ok) location.href = "/";
    else errorBox.textContent = await errorMessage(res);
  });
</script>
